# Copia este archivo a ".env" y rellena con tus valores reales.
# El ".env" real NUNCA debe subirse a git (ya está en .gitignore).

PORT=3000
NODE_ENV=development

# ── Base de datos ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña_aqui
DB_NAME=fajas_maydel

# ── JWT ─────────────────────────────────────────────────────────
# Genera una clave larga y aleatoria, p.ej.:  openssl rand -hex 32
JWT_SECRET=cambia_esto_por_una_clave_secreta_muy_larga_y_aleatoria
JWT_EXPIRES_IN=7d

# ── Usuario administrador (lo usa "npm run setup") ──────────────
# La contraseña del admin se toma de aquí; NUNCA va hardcodeada en el código.
# Debe ser un correo REAL que controles: quien reciba sus correos puede
# restablecer la contraseña del admin y entrar al panel.
ADMIN_LOGIN_EMAIL=tu_correo@example.com
ADMIN_PASSWORD=define_una_contraseña_fuerte_aqui
# Contraseña de la cuenta de comprador de prueba (db/seed_buyer.js, solo local)
SEED_BUYER_PASSWORD=

# ── Email (SMTP) ────────────────────────────────────────────────
ADMIN_EMAIL=tu_correo@ejemplo.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password
SMTP_FROM_NAME=Fajas Colombianas Maydel
# Opcional: dirección del remitente si NO es la misma que SMTP_USER (p. ej. Brevo
# con pedidos@tu-dominio.com). Debe estar verificada en tu servicio de correo.
SMTP_FROM_EMAIL=

# ── Stripe (https://dashboard.stripe.com/apikeys) ───────────────
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
# Minutos que un pedido con tarjeta puede quedar sin pagar apartando inventario
# antes de cancelarse solo (mínimo 15).
STRIPE_ORDER_TTL_MIN=60

# ── Cron de Vercel (cancela pedidos con tarjeta abandonados, 1 vez al día) ──
# Vercel lo manda como "Authorization: Bearer <CRON_SECRET>". Cadena larga aleatoria.
CRON_SECRET=

# ── URL pública del sitio ───────────────────────────────────────
PUBLIC_URL=http://localhost:3000

# ── Tarifas de envío (MXN) ──────────────────────────────────────
SHIPPING_LOCAL=150
SHIPPING_LOCAL_STATE=Chihuahua
SHIPPING_NATIONAL=200

# ── SMS / WhatsApp para recuperar contraseña (opcional) ─────────
# Sin estas claves, en producción la opción "Por SMS/WhatsApp" se oculta y solo
# queda la recuperación por correo (el modo demo solo existe en local).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# ── Telegram (opcional) ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Analytics (opcional) ────────────────────────────────────────
GA_MEASUREMENT_ID=
META_PIXEL_ID=
# Etiqueta de Google Ads (AW-XXXXXXXXX). Mide la compra en /gracias.html
GOOGLE_ADS_ID=

# ── WhatsApp de la tienda (sin + ni espacios) ───────────────────
WHATSAPP_PHONE=526143716816

# ── Login con Google ────────────────────────────────────────────
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# ── Login con Facebook ──────────────────────────────────────────
FACEBOOK_APP_ID=tu_app_id
FACEBOOK_APP_SECRET=tu_app_secret
